# Prism — LLM Arena + Router
# Add API keys for the providers you want to use

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GOOGLE_API_KEY=AI...

# Groq
GROQ_API_KEY=gsk_...

# Server
PORT=3080
HOST=localhost

# Default routing strategy: cheapest | fastest | best | round-robin
DEFAULT_STRATEGY=best

# Optional: Set a secret to require Bearer token auth on API endpoints
# PRISM_SECRET=your-secret-here
