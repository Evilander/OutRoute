# Prism runs with no keys at all (demo mode, built-in mock models).
# Add a key for each provider you want to compare. One is enough.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Local models through Ollama. Probed at http://localhost:11434 if unset.
# OLLAMA_HOST=http://localhost:11434

# Server
PORT=3080
HOST=localhost

# Required in practice if HOST is anything but localhost. Every API call must
# then send "Authorization: Bearer <PRISM_SECRET>"; only /health, /api/config
# and the dashboard's own files stay open. Twenty wrong tokens from one address
# lock that address out for a minute.
# PRISM_SECRET=

# Extra Host headers to accept (comma-separated) when serving behind a name
# other than localhost. Guards against DNS rebinding.
# ALLOWED_HOSTS=prism.internal

# Allow one browser origin to call the API cross-origin. Off by default.
# CORS_ORIGIN=https://example.com

# Routing: best | value | cheapest | fastest | round-robin
DEFAULT_STRATEGY=best

# Models the router may choose between (comma-separated ids). Default: a short
# curated list per keyed provider, plus any model you have compared. Any model
# can still be named in a request or entered in a comparison.
# PRISM_POOL=

# "value" picks the cheapest model it cannot say is worse than the leader.
# This is how sure it must be that a model is worse before ruling it out.
# PRISM_VALUE_CONFIDENCE=0.9

# Shadow evaluation: replay this fraction of real requests to a second model in
# the background and have the judge compare the two. Off at 0. Sampled prompts
# and responses are stored in the local database, and are sent to the
# challenger's provider and the judge's provider.
SHADOW_RATE=0
SHADOW_DAILY_BUDGET_USD=1.00

# Judge override. By default Prism picks a judge from a provider that has no
# contestant in the battle.
# JUDGE_PROVIDER=
# JUDGE_MODEL=

# Force the built-in mock models on even when keys are present.
# PRISM_DEMO=1

# Database file (default: ./prism.db)
# DB_PATH=
